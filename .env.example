# ---- Pocket ---------------------------------------------------------------
# copy to .env and fill in. Everything is optional except the admin token in prod.

POCKET_ENV=prod
POCKET_PUBLIC_URL=https://pocket.example.com      # what twilio/telegram call, used for signature checks
POCKET_DOMAIN=pocket.example.com                  # caddy gets a cert for this
POCKET_ADMIN_TOKEN=change-me-long-random          # dashboard password + admin api bearer token
POCKET_SECRET_KEY=change-me-too                   # signs dashboard cookies and export links

POCKET_DEFAULT_BASE_CURRENCY=EUR
POCKET_DEFAULT_TIMEZONE=Europe/Tallinn
POCKET_LLM_DAILY_COST_CAP_USD=1.0

# ---- who is allowed to talk to the bot (the allowlist) --------------------
POCKET_OWNER_WHATSAPP=whatsapp:+3725xxxxxxx
POCKET_OWNER_TELEGRAM=                            # your chat id
POCKET_OWNER_DISCORD=                             # your discord user id

# ---- LLM providers (read directly by litellm; missing ones are skipped) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# OLLAMA_API_BASE=http://ollama:11434

# ---- WhatsApp via Twilio sandbox ------------------------------------------
POCKET_TWILIO_ACCOUNT_SID=
POCKET_TWILIO_AUTH_TOKEN=
POCKET_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Telegram --------------------------------------------------------------
POCKET_TELEGRAM_BOT_TOKEN=
POCKET_TELEGRAM_WEBHOOK_SECRET=

# ---- Discord (interactions endpoint) ---------------------------------------
POCKET_DISCORD_PUBLIC_KEY=
POCKET_DISCORD_BOT_TOKEN=
POCKET_DISCORD_APPLICATION_ID=

# ---- backups ---------------------------------------------------------------
POCKET_BACKUP_KEEP=14
POCKET_BACKUP_AZURE_SAS_URL=                      # https://<acct>.blob.core.windows.net/<container>?sv=...&sig=...

# ---- storage (defaults are fine in docker) ---------------------------------
# POCKET_DATABASE_URL=sqlite:////data/pocket.db
# POCKET_DATABASE_URL=postgresql+psycopg://pocket:pocket@db:5432/pocket
