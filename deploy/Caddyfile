# TLS + reverse proxy. Set POCKET_DOMAIN in .env (e.g. pocket.shishirrijal.dev)
{$POCKET_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy api:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format json
	}
}
